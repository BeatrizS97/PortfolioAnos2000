# Supabase — Project URL é a mesma nos dois pares, o que muda é a chave
# Front-end (vai pro navegador) → use a publishable (ou anon, se seu projeto ainda for legado)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Back-end (só roda no servidor da Vercel, nunca no bundle do navegador) → use a secret (ou service_role legado)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Email
RESEND_API_KEY=re_sua_chave_aqui
CONTACT_TO_EMAIL=seu_email_aqui